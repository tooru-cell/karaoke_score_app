
<div class="max-w-5xl mx-auto px-4 pt-8 pb-24 md:pb-8">

  <h1 class="text-2xl font-bold text-slate-800 mb-6">
    👑 ランキング 👑
  </h1>

  <!-- 最高得点ランキング -->
  <section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">
    <h2 class="text-lg font-semibold text-slate-800">
      🎵 高得点ランキング
    </h2>

    <p class="text-sm text-slate-500 mb-4">
      曲ごとの最高点（上位５曲）
    </p>

    <div class="divide-y divide-slate-100">
      <% rank = 0 %>
      <% previous_score = nil %>

      <% @max_ranking.each do |song_id, score| %>
        <% if score != previous_score %>
          <% rank += 1 %>
        <% end %>

        <% previous_score = score %>

        <div class="flex items-center gap-3 py-4">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-50 text-blue-700 font-semibold shrink-0">
            <%= rank %>位
          </span>

          <div class="flex-1 min-w-0">
            <%= link_to @song_titles[song_id], song_path(song_id),
                class: "block font-medium text-slate-800 hover:text-blue-600 break-words" %>

            <% if @max_dates[song_id] %>
              <p class="text-xs text-slate-500 mt-1">
                <%= @max_dates[song_id].strftime("%Y/%m/%d") %>
              </p>
            <% end %>
          </div>

          <span class="font-semibold text-blue-600 shrink-0">
            <%= score %>点
          </span>
        </div>
      <% end %>
    </div>
  </section>

  <!-- 平均点ランキング -->
  <section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">
    <h2 class="text-lg font-semibold text-slate-800">
      🎤 得意曲ランキング
    </h2>

    <p class="text-sm text-slate-500 mb-4">
      平均点の高い楽曲（上位５曲）
    </p>

    <div class="divide-y divide-slate-100">
      <% rank = 0 %>
      <% previous_score = nil %>

      <% @average_ranking.each do |song_id, score| %>
        <% if score != previous_score %>
          <% rank += 1 %>
        <% end %>

        <% previous_score = score %>

        <div class="flex items-center gap-3 py-4">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-50 text-blue-700 font-semibold shrink-0">
            <%= rank %>位
          </span>

          <%= link_to @song_titles[song_id], song_path(song_id),
              class: "flex-1 min-w-0 font-medium text-slate-800 hover:text-blue-600 break-words" %>

          <span class="font-semibold text-blue-600 shrink-0">
            <%= score.round(2) %>点
          </span>
        </div>
      <% end %>
    </div>
  </section>

  <!-- 歌唱回数ランキング -->
  <section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">
    <h2 class="text-lg font-semibold text-slate-800 mb-4">
      💛 よく歌う曲ランキング
    </h2>

    <div class="divide-y divide-slate-100">
      <% rank = 0 %>
      <% previous_count = nil %>

      <% @count_ranking.each do |song_id, count| %>
        <% if count != previous_count %>
          <% rank += 1 %>
        <% end %>
        
        <% previous_count = count %>

        <div class="flex items-center gap-3 py-4">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-50 text-blue-700 font-semibold shrink-0">
            <%= rank %>位
          </span>

          <%= link_to @song_titles[song_id], song_path(song_id),
              class: "flex-1 min-w-0 font-medium text-slate-800 hover:text-blue-600 break-words" %>

          <span class="font-semibold text-blue-600 shrink-0">
            <%= count %>回
          </span>
        </div>
      <% end %>
    </div>
  </section>

  <%= link_to "マイページへ戻る", mypage_path,class: "inline-block text-sm text-slate-600 hover:text-blue-600 transition-colors" %>
</div>
