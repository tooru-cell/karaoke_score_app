<%= form_with model: @karaoke_score do |f| %>
<% if @karaoke_score.errors.any? %>
  <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 mb-6" role="alert">
    <h2 class="font-semibold mb-2">
      入力内容にエラーがあります
    </h2>

    <ul class="list-disc list-inside text-sm space-y-1">
      <% @karaoke_score.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
  <div class="mb-5">
    <%= f.label :score_image, "採点画像", class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.file_field :score_image,
      accept: "image/*",
      class: "block w-full text-sm text-slate-600
              file:mr-4 file:rounded-lg file:border-0
              file:bg-blue-50 file:px-4 file:py-2
              file:text-blue-700 file:font-medium
              hover:file:bg-blue-100 cursor-pointer" %>
</div>

  <div>
    <div class="mb-5">
        <%= f.label :artist_name, "アーティスト名", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_field :artist_name, class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="mb-5">
        <%= f.label :song_title, "曲名", class: "block text-sm font-medium text-slate-700 mb-2" %>
        <%= f.text_field :song_title, class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>
  </div>

  <div class="mb-5">
    <%= f.label :score, "点数", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.number_field :score, step: 0.001, min: 0, max: 100, class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="mb-5">
    <%= f.label :sung_at, "歌唱日", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.date_field :sung_at, class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="mb-5">
    <%= f.label :karaoke_machine, "機種", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.select :karaoke_machine, [["DAM", "dam"],["JOYSOUND","joysound"]], {include_blank: "選択してください"}, class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="mb-5">
    <%= f.label :memo, "メモ", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.text_area :memo, rows: 4,class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <%= f.submit @karaoke_score.persisted? ? "更新" : "登録",class: "w-full bg-blue-600 text-white font-medium py-3 rounded-lg hover:bg-blue-700 transition-colorscursor-pointer" %>

<% end %>
