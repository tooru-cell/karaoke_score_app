<div class="max-w-5xl mx-auto px-4 pt-8 pb-24 md:pb-8">

  <h1 class="text-3xl font-bold text-blue-600 mb-6">
    すべての採点履歴
  </h1>

  <!-- 検索・ソート -->
  <section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">
    <h2 class="text-xl font-bold text-slate-800 mb-4">
      👯ソート・検索
    </h2>

    <%= search_form_for @q, url: karaoke_scores_path do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

        <div>
          <%= f.label :song_title_cont, "🎵曲名",
              class: "block text-sm font-medium text-slate-700 mb-2" %>

          <%= f.search_field :song_title_cont,
              placeholder: "曲名を入力",
              class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :song_artist_name_cont, "👧アーティスト名",
              class: "block text-sm font-medium text-slate-700 mb-2" %>

          <%= f.search_field :song_artist_name_cont,
              placeholder: "アーティスト名を入力",
              class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>

        <div>
          <%= f.label :karaoke_machine_eq, "🎤機種",class: "block text-sm font-medium text-slate-700 mb-2" %>

          <%= f.select :karaoke_machine_eq,
            KaraokeScore.karaoke_machines.map { |name, value| [name.upcase, value] },{ include_blank: "すべて" },class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
        </div>


      </div>

      <div class="flex justify-end gap-3">
        <%= link_to "クリア", karaoke_scores_path,
            class: "px-4 py-2 text-slate-500 hover:text-slate-700" %>

        <%= f.submit "検索🔍",
            class: "bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 cursor-pointer" %>
      </div>
    <% end %>

    <div class="flex flex-wrap gap-2 mt-5 pt-4 border-t border-slate-200">
      <span class="text-sm text-slate-600 self-center">
        並び替え：
      </span>

      <%= sort_link(@q, :score, "点数順",
          default_order: :desc,
          class: "bg-slate-100 rounded-lg px-3 py-2 text-sm hover:bg-blue-100") %>

      <%= sort_link(@q, :sung_at, "歌唱日順",
          default_order: :desc,
          class: "bg-slate-100 rounded-lg px-3 py-2 text-sm hover:bg-blue-100") %>

      <%= sort_link(@q, :song_title, "曲名順",
          class: "bg-slate-100 rounded-lg px-3 py-2 text-sm hover:bg-blue-100") %>
    </div>
  </section>

  <!-- 検索結果 -->
  <section>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold text-slate-800">
        🎵採点履歴
      </h2>

      <%= link_to "＋ 新規登録", new_karaoke_score_path,
          class: "bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700" %>
    </div>

    <div class="space-y-3">
  <% @karaoke_scores.each do |score| %>
    <div class="bg-white border border-slate-200 rounded-xl p-4 hover:shadow-md transition-shadow">

      <div class="flex items-center justify-between gap-3">

        <div class="min-w-0">
          <%= link_to score.song.title, song_path(score.song),
              class: "block font-semibold text-slate-800 hover:text-blue-600 break-words" %>

          <p class="text-sm text-slate-500 mt-1">
            <%= score.song.artist.name %>
          </p>
        </div>

        <%= link_to karaoke_score_path(score),
            class: "text-xl font-bold text-blue-600 hover:text-blue-800 shrink-0" do %>
          <%= score.score %>点 ›
        <% end %>

      </div>

      <div class="flex items-center gap-3 mt-4 pt-3 border-t border-slate-100">
        <span class="text-sm text-slate-500">
          <%= score.sung_at.strftime("%Y/%m/%d") %>
        </span>

        <span class="text-xs bg-blue-100 text-blue-700 px-3 py-1 rounded-full">
          <%= score.karaoke_machine&.upcase || "未選択" %>
        </span>
      </div>

    </div>
  <% end %>

  <% if @karaoke_scores.empty? %>
    <p class="bg-white rounded-xl p-6 text-center text-slate-500">
      該当する採点履歴がありません。
    </p>
  <% end %>
</div>
  </section>

  <div class="mt-6">
    <%= link_to "👑ランキングを見る", rankings_path,
        class: "inline-block bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded-lg hover:bg-slate-100" %>
  </div>

</div>
