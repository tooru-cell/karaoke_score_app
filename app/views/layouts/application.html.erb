<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Myapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    
    <% ogp_title = "カラオケ採点記録アプリ" %>
    <% ogp_description = "カラオケの採点結果を記録・分析。ランキングやグラフで自分の成長を確認できます。" %>

    <meta name="description" content="<%= ogp_description %>">

    <meta property="og:title" content="<%= ogp_title %>">
    <meta property="og:description" content="<%= ogp_description %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.base_url + root_path %>">
    <meta property="og:image" content="<%= request.base_url + '/ogp.png' %>">
    <meta property="og:image:alt" content="カラオケ採点記録アプリの紹介画像">
    <meta property="og:site_name" content="<%= ogp_title %>">
    <meta property="og:locale" content="ja_JP">

    <meta name="twitter:card" content="summary_large_image">

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
      <meta name="theme-color" content="#15518e">
    <link rel="apple-touch-icon" href="/icon-192.png">

  </head>

  <body class="bg-slate-50 text-slate-800 min-h-screen">
  <%= render "shared/header" %>
    <% if flash[:notice] %>
      <p><%= flash[:notice] %></p>
    <% end %>

    <% if flash[:alert] %>
      <p><%= flash[:alert] %></p>
    <% end %>

    <%= yield %>
    <% if logged_in? %>
      <%= render "shared/bottom_nav" %>
    <% end %>
  </body>
</html>
