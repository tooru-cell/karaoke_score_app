
<div class="max-w-5xl mx-auto px-4 pt-8 pb-24 md:pb-8">

  <div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">
      <%= @song.title %> の歌唱履歴
    </h1>

    <p class="text-slate-500 mt-2">
      <%= @song.artist.name %>
    </p>
  </div>

  
<!-- 検索・ソート -->
<section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">
  <h2 class="text-xl font-bold text-slate-800 mb-4">
    👯ソート
  </h2>

  <%= search_form_for @q, url: history_song_path(@song) do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

      <div>
        <%= f.label :karaoke_machine_eq, "🎤機種",
            class: "block text-sm font-medium text-slate-700 mb-2" %>

        <%= f.select :karaoke_machine_eq,
            KaraokeScore.karaoke_machines.map { |name, value| [name.upcase, value] },
            { include_blank: "すべて" },
            class: "w-full border border-slate-300 rounded-lg px-3 py-2" %>
      </div>

    </div>

    <div class="flex justify-end gap-3">
      <%= link_to "クリア", history_song_path(@song),
          class: "px-4 py-2 text-sm text-slate-500 hover:text-slate-700" %>

      <%= f.submit "検索🔍",
          class: "bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 cursor-pointer" %>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-2 mt-5 pt-4 border-t border-slate-200">
    <span class="text-sm font-medium text-slate-600 mr-2">
      並び替え
    </span>

    <%= sort_link(@q, :score, "点数順",
        default_order: :desc,
        class: "bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-colors") %>

    <%= sort_link(@q, :sung_at, "歌唱日順",
        default_order: :desc,
        class: "bg-white border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-colors") %>
  </div>
</section>


  <!-- 全履歴 -->
  <section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">

    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-slate-800">
        すべての歌唱履歴
      </h2>

      <span class="text-sm text-slate-500">
        <%= @scores.size %>件
      </span>
    </div>

    <div class="divide-y divide-slate-100">
      <% @scores.each do |score| %>
        <div class="flex items-center justify-between gap-4 py-4">

          <div class="min-w-0">
            <p class="text-sm text-slate-700">
              <%= score.sung_at.strftime("%Y/%m/%d") %>
            </p>

            <span class="inline-block mt-2 text-xs font-medium bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
              <%= score.karaoke_machine&.upcase || "未選択" %>
            </span>
          </div>

          <%= link_to karaoke_score_path(score),
              class: "shrink-0 flex items-center gap-2 text-blue-600 hover:text-blue-800 font-semibold" do %>
            <span><%= score.score %>点</span>
            <span aria-hidden="true">›</span>
          <% end %>

        </div>
      <% end %>
    </div>

    <% if @scores.empty? %>
      <p class="text-center text-slate-500 py-4">
        まだ歌唱履歴がありません。
      </p>
    <% end %>

  </section>

  <%= link_to "← 楽曲詳細へ戻る", song_path(@song),
      class: "inline-block text-sm text-slate-600 hover:text-blue-600 transition-colors" %>

</div>
