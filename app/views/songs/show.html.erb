<div class="max-w-5xl mx-auto px-4 pt-8 pb-24 md:pb-8">

  <div class="bg-white border border-slate-200 rounded-xl p-6 mb-6">
    <h1 class="text-2xl font-bold text-slate-800">
      <%= @song.title %>
    </h1>

    <p class="text-slate-500 mt-2">
      <%= @song.artist.name %>
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">

    <div class="bg-white border border-slate-200 rounded-xl p-5 text-center">
      <p class="text-sm text-slate-500 mb-2">最高点</p>
      <p class="text-2xl font-bold text-blue-600">
        <%= @highest_score %>
        <span class="text-sm text-slate-500 font-normal">点</span>
      </p>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl p-5 text-center">
      <p class="text-sm text-slate-500 mb-2">平均点</p>
      <p class="text-2xl font-bold text-blue-600">
        <%= @average_score&.round(3) %>
        <span class="text-sm text-slate-500 font-normal">点</span>
      </p>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl p-5 text-center">
      <p class="text-sm text-slate-500 mb-2">歌唱回数</p>
      <p class="text-2xl font-bold text-blue-600">
        <%= @sing_count %>
        <span class="text-sm text-slate-500 font-normal">回</span>
      </p>
    </div>

  </div>

  <% if @difference %>
    <div class="bg-blue-50 border border-blue-100 rounded-lg p-4 mb-6">
      <p class="text-sm text-slate-700">
        前回との点数差：
        <span class="font-semibold <%= @difference.positive? ? 'text-green-700' : (@difference.negative? ? 'text-red-600' : 'text-slate-700') %>">
          <%= @difference > 0 ? "+" : "" %><%= @difference.round(3) %>点
        </span>
      </p>
    </div>
  <% end %>

<section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">
  <h2 class="text-lg font-semibold text-slate-800 mb-4">
    採点履歴
  </h2>

  <div class="divide-y divide-slate-100">
    <% @scores.each do |score| %>
      <div class="flex items-center justify-between gap-4 py-4">

        <div class="min-w-0">
          <p class="text-sm text-slate-700">
            <%= score.sung_at %>
          </p>

          <span class="inline-block mt-2 text-xs font-medium bg-blue-50 text-blue-700 px-3 py-1 rounded-full">
            <%= score.karaoke_machine&.upcase || "未選択" %>
          </span>
        </div>

        <%= link_to karaoke_score_path(score),
            class: "shrink-0 flex items-center gap-2 text-blue-600 hover:text-blue-800 font-semibold" do %>
          <span><%= score.score %>点</span>
          <span aria-hidden="true">›</span>
        <% end %>

      </div>
    <% end %>
  </div>
</section>

<section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">
  <h2 class="text-lg font-semibold text-slate-800 mb-4">
    点数推移グラフ
  </h2>

  <div class="w-full">
<div style="max-width: 600px;">
  <%= line_chart @chart_data,
  discrete: true,
  width: "100%",
  height: "300px",
  library: {
    scales: {
      x: {
        type: "category"
      }
    }
  }
%>
</div>
  </div>
</section>
<section class="bg-white border border-slate-200 rounded-xl p-5 mb-6">
  <h2 class="text-lg font-semibold text-slate-800 mb-4">
  機種別点数推移グラフ
  </h2>

<div style="max-width: 600px;">
  <%= line_chart @machine_chart_data,
    discrete: true,
    width: "100%",
    height: "300px",
    library: {
      spanGaps: true,
      scales: {
        x: {
          type: "category"
        }
      }
    }
  %>
</div>
  </div>
</section>

<%= link_to "← 採点履歴へ戻る", karaoke_scores_path,
    class: "inline-block text-sm text-slate-600 hover:text-blue-600 transition-colors" %>

</div>
