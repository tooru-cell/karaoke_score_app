<div class="max-w-md mx-auto px-4 pt-12 pb-24 md:pb-12">

  <div class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8">

    <h1 class="text-2xl font-bold text-slate-800 text-center mb-8">
      ユーザー登録
    </h1>

    <%= form_with model: @user do |f| %>

      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 mb-6" role="alert">
          <h2 class="font-semibold mb-2">
            入力内容にエラーがあります
          </h2>

          <ul class="list-disc list-inside text-sm space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-5">
        <%= f.label :name, "ユーザー名",
            class: "block text-sm font-medium text-slate-700 mb-2" %>

        <%= f.text_field :name,
            autocomplete: "username",
            class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="mb-5">
        <%= f.label :email, "メールアドレス",
            class: "block text-sm font-medium text-slate-700 mb-2" %>

        <%= f.email_field :email,
            autocomplete: "email",
            class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="mb-5">
        <%= f.label :password, "パスワード",
            class: "block text-sm font-medium text-slate-700 mb-2" %>

        <%= f.password_field :password,
            autocomplete: "new-password",
            class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="mb-6">
        <%= f.label :password_confirmation, "パスワード（確認）",
            class: "block text-sm font-medium text-slate-700 mb-2" %>

        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <%= f.submit "登録する",
          class: "w-full bg-blue-600 text-white font-medium py-3 rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>

    <% end %>

    <p class="text-center text-sm text-slate-500 mt-6">
      すでにアカウントをお持ちの方は
      <%= link_to "ログイン", login_path,
          class: "text-blue-600 font-medium hover:text-blue-700" %>
    </p>

  </div>
</div>